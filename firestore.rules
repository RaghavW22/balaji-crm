rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Any authenticated user can access the shared company workspace
    match /users/{userId} {
      allow read, write: if request.auth != null;

      // Leads subcollection
      match /leads/{leadId} {
        allow read, write: if request.auth != null;
      }

      // Products catalog subcollection
      match /products/{productId} {
        allow read, write: if request.auth != null;
      }

      // API / app settings subcollection
      match /settings/{settingId} {
        allow read, write: if request.auth != null;
      }

      // Sent replies subcollection
      match /sent_replies/{replyId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
